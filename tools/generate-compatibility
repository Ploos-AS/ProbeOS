#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Generate conservative compatibility documentation from reviewed evidence."""

import argparse
import json
from collections import Counter, defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PATHS = [("x86_64", "grub", "bios"), ("x86_64", "grub", "uefi"), ("x86_64", "syslinux", "bios"), ("x86", "grub", "bios"), ("x86", "syslinux", "bios")]


def records(directory):
    values = []
    for path in sorted(Path(directory).glob("*.json")):
        value = json.loads(path.read_text(encoding="utf-8"))
        if value.get("environment_type") == "physical" and value.get("review", {}).get("status") == "approved": values.append(value)
    return values


def generate(physical_dir, emulator_file):
    physical = records(physical_dir); emulator = json.loads(Path(emulator_file).read_text(encoding="utf-8"))
    fingerprints = {item["machine"]["fingerprint"] for item in physical}
    emu_paths = {(x["architecture"], x["bootloader"], x["firmware_mode"]): x for x in emulator.get("paths", [])}
    lines = ["<!-- SPDX-License-Identifier: GPL-3.0-or-later -->", "<!-- Generated by tools/generate-compatibility; do not edit manually. -->", "# ProbeOS compatibility evidence", "", "Compatibility claims here derive only from reviewed evidence. QEMU evidence is regression evidence and never counts as physical-machine evidence.", "", "## Evidence totals", "", f"- Reviewed physical machines: {len(fingerprints)}", f"- Reviewed physical qualification runs: {len(physical)}", "- Real physical evidence is version-specific; synthetic fixtures are excluded.", "", "## Boot paths", "", "| Architecture | Bootloader | Firmware | Emulator | Physical evidence |", "| --- | --- | --- | --- | --- |"]
    for key in PATHS:
        matching = [x for x in physical if (x["platform"].get("architecture"), x["platform"].get("bootloader"), x["platform"].get("firmware_mode")) == key]
        passed = sum(x.get("overall_status") == "PASS" for x in matching)
        physical_text = f"{len(matching)} run(s), {passed} PASS" if matching else "No physical evidence yet"
        emu = emu_paths.get(key); emu_text = (emu or {}).get("linux", "NOT_TESTED") + " (QEMU)" if emu else "NOT_TESTED"
        lines.append(f"| {key[0]} | {key[1].upper()} | {key[2].upper()} | {emu_text} | {physical_text} |")
    lines += ["", "Secure Boot is not supported or claimed. IA32 UEFI is not qualified. No minimum CPU generation or physical RAM requirement is inferred from this evidence.", "", "## Reviewed physical-machine runs", ""]
    if not physical: lines.append("No reviewed physical-machine evidence has been collected yet.")
    else:
        lines += ["| Manufacturer | Model | CPU | Boot path | ProbeOS | Result |", "| --- | --- | --- | --- | --- | --- |"]
        for item in sorted(physical, key=lambda x: (str(x["machine"].get("manufacturer")), str(x["machine"].get("model")), x["qualification_id"])):
            machine, boot, probe = item["machine"], item["platform"], item["probeos"]
            lines.append("| {} | {} | {} | {} / {} / {} | {} | {} |".format(machine.get("manufacturer") or "Unknown", machine.get("model") or "Unknown", machine.get("cpu") or "Unknown", boot.get("architecture"), str(boot.get("bootloader")).upper(), str(boot.get("firmware_mode")).upper(), probe.get("version"), item.get("overall_status")))
    lines += ["", "## Component observations", "", "Component summaries mean only ‘observed in tested configurations’; they are not universal support claims."]
    components = defaultdict(lambda: Counter(observed=0, driver=0))
    for item in physical:
        for kind in ("network_controllers", "graphics_controllers", "storage_controllers", "usb_controllers"):
            for component in item["machine"].get(kind) or []:
                name = component.get("description") or component.get("model") or component.get("name")
                if name:
                    components[(kind, name)]["observed"] += 1
                    if component.get("driver"): components[(kind, name)]["driver"] += 1
    if not components: lines += ["", "No reviewed physical component observations yet."]
    else:
        lines += ["", "| Type | Component | Physical runs observed | Driver recorded |", "| --- | --- | ---: | ---: |"]
        for (kind, name), counts in sorted(components.items()): lines.append(f"| {kind.replace('_controllers', '')} | {name} | {counts['observed']} | {counts['driver']} |")
    lines += ["", "## Failures and partial results", ""]
    adverse = [x for x in physical if x.get("overall_status") != "PASS"]
    if not adverse: lines.append("No reviewed physical failure or partial records are present.")
    else:
        for item in adverse: lines.append(f"- `{item['qualification_id']}`: {item['overall_status']} on {item['probeos'].get('version')} ({item['platform'].get('architecture')} / {item['platform'].get('bootloader')} / {item['platform'].get('firmware_mode')}).")
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(); parser.add_argument("--physical-dir", default=str(ROOT / "compatibility/physical")); parser.add_argument("--emulator", default=str(ROOT / "compatibility/emulator/qemu-current.json")); parser.add_argument("--output", default=str(ROOT / "docs/compatibility.md")); parser.add_argument("--check", action="store_true"); args = parser.parse_args()
    content = generate(args.physical_dir, args.emulator); output = Path(args.output)
    if args.check:
        if not output.exists() or output.read_text(encoding="utf-8") != content: raise SystemExit("generated compatibility documentation differs")
    else: output.write_text(content, encoding="utf-8")


if __name__ == "__main__": main()
