#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Runtime-only wired DHCP/static network helper for ProbeOS.
set -euo pipefail
RUNTIME_DIR=${PROBEOS_NETWORK_RUNTIME_DIR:-/run/probeos}

network_interfaces() {
    for path in /sys/class/net/*; do
        [ -e "$path" ] || continue
        name=${path##*/}
        [ "$name" = lo ] && continue
        [ "$(cat "$path/type" 2>/dev/null || true)" = 1 ] || continue
        printf '%s\n' "$name"
    done
}

json_status() {
    local addresses routes
    addresses=$(ip -j -4 addr show 2>/dev/null || printf '[]')
    routes=$(ip -j -4 route show default 2>/dev/null || printf '[]')
    jq --argjson routes "$routes" '
      [ .[] | select(.ifname != "lo") | {interface:.ifname,link_state:(.operstate // "unknown"),ipv4:([.addr_info[]? | select(.family=="inet") | {address:.local,prefix:.prefixlen}]),gateway:([ $routes[] | select(.dev==.ifname) | .gateway ] | first // null),method:"unknown"} ]' <<<"$addresses"
}

show_status() {
    if [ "${1:-text}" = json ]; then
        json_status
        return
    fi
    printf '%s\n' 'ProbeOS Network Status' '----------------------'
    for iface in $(network_interfaces); do
        state=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || printf 'unknown')
        mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null || printf 'unknown')
        speed=$(ethtool "$iface" 2>/dev/null | sed -n 's/^[[:space:]]*Speed:[[:space:]]*//p' | head -n1)
        [ -n "$speed" ] || speed=unknown
        addresses=$(ip -4 -o addr show dev "$iface" scope global 2>/dev/null | awk '{print $4}' | paste -sd, -)
        [ -n "$addresses" ] || addresses=none
        gateway=$(ip -4 route show default dev "$iface" 2>/dev/null | awk '{print $3; exit}')
        [ -n "$gateway" ] || gateway=none
        method=manual
        [ -f "$RUNTIME_DIR/dhcp.$iface" ] && method=DHCP
        printf 'Interface: %s\n  Link: %s\n  Address: %s\n  Gateway: %s\n  Speed: %s\n  Method: %s\n  MAC: %s\n' "$iface" "$state" "$addresses" "$gateway" "$speed" "$method" "$mac"
    done
}

configure_dhcp() {
    iface=${1:?usage: probeos-network dhcp INTERFACE}
    [ -d "/sys/class/net/$iface" ] || { echo "unknown interface: $iface" >&2; return 2; }
    ip link set dev "$iface" up
    rm -f "$RUNTIME_DIR/dhcp.$iface" "$RUNTIME_DIR/udhcpc.$iface.pid"
    if udhcpc -q -n -t 3 -T 3 -i "$iface" -s /usr/local/bin/probeos-udhcpc -p "$RUNTIME_DIR/udhcpc.$iface.pid"; then
        : > "$RUNTIME_DIR/dhcp.$iface"
        return 0
    fi
    rm -f "$RUNTIME_DIR/dhcp.$iface"
    echo "DHCP failed on $iface; ProbeOS remains usable offline." >&2
    return 1
}

configure_static() {
    iface=${1:?usage: probeos-network static INTERFACE ADDRESS[/PREFIX] [GATEWAY]}
    address=${2:?usage: probeos-network static INTERFACE ADDRESS[/PREFIX] [GATEWAY]}
    gateway=${3:-}
    [ -d "/sys/class/net/$iface" ] || { echo "unknown interface: $iface" >&2; return 2; }
    [[ "$address" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] || { echo 'invalid IPv4/prefix' >&2; return 2; }
    if [ -n "$gateway" ]; then
        [[ "$gateway" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { echo 'invalid IPv4 gateway' >&2; return 2; }
    fi
    ip link set dev "$iface" up
    ip -4 addr flush dev "$iface" scope global
    ip -4 addr add "$address" dev "$iface"
    if [ -n "$gateway" ]; then ip -4 route replace default via "$gateway" dev "$iface"; fi
    rm -f "$RUNTIME_DIR/dhcp.$iface"
}

mkdir -p "$RUNTIME_DIR"
case "${1:-status}" in
    interfaces) network_interfaces ;;
    status) show_status "${2:-text}" ;;
    dhcp) configure_dhcp "${2:-}" ;;
    static) configure_static "${2:-}" "${3:-}" "${4:-}" ;;
    auto)
        for iface in $(network_interfaces); do
            configured=0
            for attempt in 1 2 3 4 5; do
                : "$attempt"
                configure_dhcp "$iface" && { configured=1; break; }
                sleep 2
            done
            [ "$configured" = 1 ] || true
        done
        ;;
    *) echo "usage: $0 {interfaces|status [json]|dhcp IFACE|static IFACE ADDRESS[/PREFIX] [GATEWAY]|auto}" >&2; exit 2 ;;
esac
