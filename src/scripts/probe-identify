#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# ProbeOS Hardware Identification v2 reporting extension
# Read-only inventory collector. Normal reports never contain an unmasked key.
set -uo pipefail

VERSION="2.0"
RELEASE_FILE=${PROBEOS_RELEASE_FILE:-/etc/probeos-release}
PRODUCT_VERSION=development
BUILD_CHANNEL=development
GIT_COMMIT=unknown
if [[ -r $RELEASE_FILE ]]; then
    PRODUCT_VERSION=$(sed -n 's/^PROBEOS_VERSION=//p' "$RELEASE_FILE" | head -n1)
    BUILD_CHANNEL=$(sed -n 's/^PROBEOS_BUILD_CHANNEL=//p' "$RELEASE_FILE" | head -n1)
    GIT_COMMIT=$(sed -n 's/^PROBEOS_GIT_COMMIT=//p' "$RELEASE_FILE" | head -n1)
fi
OUTPUT_DIR="${PROBE_OUTPUT_DIR:-/run/probeos}"
FIXTURE_DIR="${PROBE_FIXTURE_DIR:-}"
ALLOW_WINDOWS_MOUNT="${PROBE_ALLOW_WINDOWS_MOUNT:-1}"
REVEAL_KEY=0
EXPORT_KEY=""
SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# PROBE_LIB is an intentional test/install override.
# shellcheck disable=SC1090
. "${PROBE_LIB:-$SELF_DIR/../lib/probe-identify-lib.sh}"

usage() {
    cat <<'EOF'
Usage: probe-identify [options]
  --output-dir DIR       report destination (default: /run/probeos)
  --fixture-dir DIR      read command outputs from fixtures (tests)
  --no-windows-mount     do not mount candidate Windows volumes
  --reveal-key           show discovered Windows keys on the local terminal only
  --export-key FILE      export Windows license information to FILE (mode 0600)
  --help                 show this help
EOF
}

while (($#)); do
    case "$1" in
        --output-dir) OUTPUT_DIR=${2:?missing output directory}; shift 2 ;;
        --fixture-dir) FIXTURE_DIR=${2:?missing fixture directory}; shift 2 ;;
        --no-windows-mount) ALLOW_WINDOWS_MOUNT=0; shift ;;
        --reveal-key) REVEAL_KEY=1; shift ;;
        --export-key) EXPORT_KEY=${2:?missing export path}; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'probe-identify: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

export PROBE_FIXTURE_DIR="$FIXTURE_DIR"
umask 077
mkdir -p "$OUTPUT_DIR" || { echo "probe-identify: cannot create $OUTPUT_DIR" >&2; exit 1; }
TMP=$(mktemp -d "${TMPDIR:-/tmp}/probe-identify.XXXXXX") || exit 1
SENSITIVE_KEYS_FILE="$TMP/windows-license-keys.jsonl"
export SENSITIVE_KEYS_FILE
: > "$SENSITIVE_KEYS_FILE"
MOUNTS=""
cleanup() {
    local mountpoint
    for mountpoint in $MOUNTS; do umount "$mountpoint" >/dev/null 2>&1 || true; done
    rm -rf "$TMP"
}
trap cleanup EXIT HUP INT TERM

have jq || { echo 'probe-identify: jq is required to generate valid JSON' >&2; exit 1; }

capture lscpu lscpu
capture dmidecode dmidecode
capture lspci lspci -Dnnk
capture lsusb lsusb
capture lsusb_tree lsusb -t
capture lsblk lsblk -J -b -O
capture ip_link ip -j link show
capture ethtool ethtool
capture sensors sensors -j
capture nvme nvme list -o json
capture acpidump acpidump -s

cpu_json=$(parse_cpu "$TMP/lscpu")
cpuinfo_source=$(fixture_path cpuinfo)
[[ -z "$cpuinfo_source" ]] && cpuinfo_source=/proc/cpuinfo
microcode=$(awk -F: '/^microcode[[:space:]]*:/{gsub(/^[[:space:]]+/,"",$2); print $2; exit}' "$cpuinfo_source" 2>/dev/null || true)
[[ -z "$microcode" ]] || cpu_json=$(jq --arg microcode "$microcode" 'if length>0 then .[0].microcode=$microcode else . end' <<<"$cpu_json")
pci_json=$(parse_pci "$TMP/lspci")
storage_json=$(parse_storage "$TMP/lsblk")
storage_json=$(enrich_storage "$storage_json" "$TMP/nvme")
usb_json=$(parse_usb "$TMP/lsusb")
network_json=$(parse_network "$TMP/ip_link")
network_json=$(enrich_network "$network_json")

msdm_file=$(fixture_path msdm)
if [[ -z "$msdm_file" && -r /sys/firmware/acpi/tables/MSDM ]]; then msdm_file=/sys/firmware/acpi/tables/MSDM; fi
firmware_key=$(extract_msdm_key "$msdm_file")
firmware_license_json=$(firmware_license_json "$msdm_file" "$firmware_key")

windows_json=$(discover_windows "$TMP" "$ALLOW_WINDOWS_MOUNT")
if [[ -n "$firmware_key" ]]; then
    jq -nc --arg key "$firmware_key" '{source:"firmware_msdm",key:$key,key_type:"OEM_DM",confidence:"high",reusable_hint:"May be useful for reinstalling the matching edition; activation is not guaranteed.",edition_hint:null,installation:null}' >> "$SENSITIVE_KEYS_FILE"
fi

if [[ -n "$EXPORT_KEY" ]]; then
    (umask 077; { printf 'ProbeOS Windows License Information\n\n'; jq -r '"Product key: \(.key)\nSource: \(.source)\nType: \(.key_type)\nConfidence: \(.confidence)\nEdition: \(.edition_hint // "Unknown")\nReuse: \(.reusable_hint)\n"' "$SENSITIVE_KEYS_FILE"; printf 'Microsoft activation acceptance cannot be guaranteed. Product ID is not a product key.\n'; } > "$EXPORT_KEY") || exit 1
fi
if ((REVEAL_KEY)); then
    if [[ -s "$SENSITIVE_KEYS_FILE" ]]; then
        jq -r '"Windows product key: \(.key)\nSource: \(.source)\nType: \(.key_type)\nConfidence: \(.confidence)\nEdition: \(.edition_hint // "Unknown")\nReuse: \(.reusable_hint)\n"' "$SENSITIVE_KEYS_FILE"
        printf 'Microsoft activation acceptance cannot be guaranteed. Product ID is not a product key.\n'
    else
        printf 'Windows product key: Not found\nOffline digital-license status cannot be reliably determined.\n'
    fi
fi

boot_mode=BIOS
[[ -d /sys/firmware/efi ]] && boot_mode=UEFI
secure_boot=unknown
if [[ "$boot_mode" == UEFI ]] && have mokutil; then
    sb=$(run mokutil --sb-state | tr '[:upper:]' '[:lower:]')
    [[ "$sb" == *enabled* ]] && secure_boot=enabled
    [[ "$sb" == *disabled* ]] && secure_boot=disabled
fi

hostname_value=$(run hostname | head -n1)
kernel_value=$(run uname -r | head -n1)
arch_value=$(run uname -m | head -n1)
timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

system_json=$(jq -n \
    --arg manufacturer "$(dmi_value "$TMP/dmidecode" 'System Information' 'Manufacturer')" \
    --arg product "$(dmi_value "$TMP/dmidecode" 'System Information' 'Product Name')" \
    --arg version "$(dmi_value "$TMP/dmidecode" 'System Information' 'Version')" \
    --arg serial "$(dmi_value "$TMP/dmidecode" 'System Information' 'Serial Number')" \
    --arg uuid "$(dmi_value "$TMP/dmidecode" 'System Information' 'UUID')" \
    --arg chassis_type "$(dmi_value "$TMP/dmidecode" 'Chassis Information' 'Type')" \
    --arg chassis_serial "$(dmi_value "$TMP/dmidecode" 'Chassis Information' 'Serial Number')" \
    'def n($x): if $x=="" then null else $x end; {manufacturer:n($manufacturer),product:n($product),version:n($version),serial_number:n($serial),uuid:n($uuid),chassis:{type:n($chassis_type),serial_number:n($chassis_serial)}}')

firmware_json=$(jq -n \
    --arg boot "$boot_mode" --arg secure "$secure_boot" \
    --arg vendor "$(dmi_value "$TMP/dmidecode" 'BIOS Information' 'Vendor')" \
    --arg version "$(dmi_value "$TMP/dmidecode" 'BIOS Information' 'Version')" \
    --arg date "$(dmi_value "$TMP/dmidecode" 'BIOS Information' 'Release Date')" \
    --arg acpi "$(status_for acpidump)" --arg dmi "$(status_for dmidecode)" \
    'def n($x):if $x=="" then null else $x end; {boot_mode:$boot,secure_boot:$secure,vendor:n($vendor),version:n($version),release_date:n($date),acpi:{status:$acpi},smbios:{status:$dmi}}')

motherboard_json=$(jq -n \
    --arg vendor "$(dmi_value "$TMP/dmidecode" 'Base Board Information' 'Manufacturer')" \
    --arg model "$(dmi_value "$TMP/dmidecode" 'Base Board Information' 'Product Name')" \
    --arg version "$(dmi_value "$TMP/dmidecode" 'Base Board Information' 'Version')" \
    --arg serial "$(dmi_value "$TMP/dmidecode" 'Base Board Information' 'Serial Number')" \
    'def n($x):if $x=="" then null else $x end; {vendor:n($vendor),model:n($model),version:n($version),serial_number:n($serial)}')

memory_json=$(parse_memory "$TMP/dmidecode")
graphics_json=$(printf '%s' "$pci_json" | jq '[.[] | select((.class // "") | test("VGA|3D|Display";"i"))]')
graphics_json=$(enrich_graphics "$graphics_json")
sensors_json=$(parse_sensors "$TMP/sensors")
power_json=$(parse_power)

jq -n \
    --arg version "$VERSION" --arg product_version "$PRODUCT_VERSION" \
    --arg build_channel "$BUILD_CHANNEL" --arg git_commit "$GIT_COMMIT" \
    --arg generated "$timestamp" --arg hostname "$hostname_value" \
    --arg kernel "$kernel_value" --arg arch "$arch_value" \
    --argjson system "$system_json" --argjson firmware "$firmware_json" \
    --argjson motherboard "$motherboard_json" --argjson cpu "$cpu_json" \
    --argjson memory "$memory_json" --argjson pci "$pci_json" --argjson usb "$usb_json" \
    --argjson graphics "$graphics_json" --argjson storage "$storage_json" \
    --argjson network "$network_json" --argjson sensors "$sensors_json" \
    --argjson power "$power_json" --argjson firmware_license "$firmware_license_json" \
    --argjson installations "$windows_json" \
    'def n($x):if $x=="" then null else $x end; {schema_version:"1.1",report_profiles:["sale","detailed","full"],default_human_profile:"sale",probeos:{product_version:$product_version,build_channel:$build_channel,git_commit:n($git_commit),tool:"probe-identify",tool_version:$version,generated_at:$generated,hostname:n($hostname),kernel:n($kernel),architecture:n($arch)},system:$system,firmware:$firmware,motherboard:$motherboard,cpu:$cpu,memory:$memory,pci:$pci,usb:$usb,graphics:$graphics,storage:$storage,network:$network,sensors:$sensors,power:$power,windows:{firmware_license:$firmware_license,installations:$installations,digital_license_status:"cannot be reliably determined offline"}}' \
    > "$OUTPUT_DIR/report.json.tmp" || exit 1
jq empty "$OUTPUT_DIR/report.json.tmp" || exit 1
mv "$OUTPUT_DIR/report.json.tmp" "$OUTPUT_DIR/report.json"
renderer=${PROBE_REPORT_RENDERER:-$SELF_DIR/../lib/report-render.py}
[[ -x "$renderer" ]] || { echo "probe-identify: report renderer is unavailable" >&2; exit 1; }
"$renderer" "$OUTPUT_DIR/report.json" "$OUTPUT_DIR" || exit 1
cp "$OUTPUT_DIR/sale.txt" "$OUTPUT_DIR/report.txt"
chmod 0644 "$OUTPUT_DIR"/report.json "$OUTPUT_DIR"/report.txt "$OUTPUT_DIR"/sale.* "$OUTPUT_DIR"/detailed.* "$OUTPUT_DIR"/full.*
printf 'ProbeOS report profiles written to %s (sale is the default)\n' "$OUTPUT_DIR"
